table mart_data_dictionary
	lineageTag: 23dd9fe9-12cd-4a6b-b1eb-2d40b85f3acc

	column dictionary_scope
		dataType: string
		lineageTag: be2f1a7f-9f76-43dc-8b1c-b3aa8e948958
		sourceColumn: dictionary_scope

	column display_order
		dataType: string
		lineageTag: cfdf063f-a123-43b7-bd3c-9fc4cb084e32
		sourceColumn: display_order

	column field_name
		dataType: string
		lineageTag: 6a67d633-9619-484d-93c2-06f3fa90dd69
		sourceColumn: field_name

	column data_type
		dataType: string
		lineageTag: 58b72a64-7d72-44c9-9135-8d9e00cf0c12
		sourceColumn: data_type

	column business_description
		dataType: string
		lineageTag: 68dce4a5-4b45-4dd3-988b-c3741bede3df
		sourceColumn: business_description

	column source_or_logic
		dataType: string
		lineageTag: f2f01f7f-2328-462d-ad79-bbe57ef52d32
		sourceColumn: source_or_logic

	column analysis_role
		dataType: string
		lineageTag: 9a88ff94-5a56-4953-81ec-09008022708f
		sourceColumn: analysis_role

	column quality_note
		dataType: string
		lineageTag: b6d32d09-a213-4c53-8b23-b4d0b5fc61a9
		sourceColumn: quality_note

	partition mart_data_dictionary = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database("localhost:5432", "practice_db", [CreateNavigationProperties=false]),
					Raw = Source{[Schema="employees_churn", Item="mart_data_dictionary"]}[Data],
					DataTypes = [VARCHAR = "Văn bản", TEXT = "Văn bản", INTEGER = "Số nguyên", BIGINT = "Số nguyên", NUMERIC = "Số thập phân", BOOLEAN = "Có / Không"],
					DictionaryLabels = [#"employee_id" = "Mã nhận diện duy nhất của nhân viên", #"age" = "Tuổi của nhân viên", #"age_band" = "Nhóm tuổi dùng để so sánh", #"age_band_order" = "Thứ tự hiển thị nhóm tuổi", #"gender" = "Giới tính được ghi nhận", #"education_level" = "Trình độ học vấn cao nhất được ghi nhận", #"marital_status" = "Tình trạng hôn nhân được ghi nhận", #"tenure" = "Số năm làm việc", #"tenure_band" = "Nhóm thâm niên dùng để so sánh", #"tenure_band_order" = "Thứ tự hiển thị nhóm thâm niên", #"analysis_year" = "Năm giả định dùng cho phân tích", #"estimated_hire_year" = "Năm bắt đầu làm việc được ước tính", #"job_role" = "Vị trí công việc", #"department" = "Phòng ban", #"team_proxy" = "Nhóm tạm tính từ phòng ban và vị trí", #"work_location" = "Hình thức làm việc", #"salary" = "Mức lương được ghi nhận", #"performance_rating" = "Điểm kết quả làm việc từ 1 đến 5", #"performance_group" = "Nhóm kết quả làm việc", #"performance_group_order" = "Thứ tự hiển thị nhóm kết quả làm việc", #"projects_completed" = "Số dự án đã hoàn thành", #"training_hours" = "Số giờ đào tạo", #"promotions" = "Thông tin đã được thăng chức hay chưa", #"overtime_hours" = "Số giờ làm thêm", #"overtime_band" = "Nhóm giờ làm thêm", #"overtime_band_order" = "Thứ tự hiển thị nhóm giờ làm thêm", #"average_monthly_hours_worked" = "Số giờ làm việc trung bình mỗi tháng", #"monthly_hours_band" = "Nhóm giờ làm việc mỗi tháng", #"monthly_hours_band_order" = "Thứ tự hiển thị nhóm giờ làm việc", #"satisfaction_level" = "Điểm hài lòng từ 0 đến 1", #"satisfaction_band" = "Nhóm mức hài lòng", #"satisfaction_band_order" = "Thứ tự hiển thị nhóm hài lòng", #"absenteeism" = "Mức vắng mặt được ghi nhận", #"distance_from_home" = "Khoảng cách từ nhà đến nơi làm việc", #"manager_feedback_score" = "Điểm đánh giá của quản lý từ 1 đến 10", #"feedback_band" = "Nhóm điểm đánh giá của quản lý", #"feedback_band_order" = "Thứ tự hiển thị nhóm đánh giá", #"peer_count" = "Số nhân viên trong nhóm so sánh", #"peer_avg_salary" = "Lương trung bình của nhóm cùng vị trí và thâm niên", #"peer_median_salary" = "Mức lương giữa nhóm cùng vị trí và thâm niên", #"salary_quartile" = "Nhóm vị trí lương từ thấp đến cao", #"salary_gap_vs_peer_median_pct" = "Chênh lệch phần trăm so với mức lương giữa nhóm", #"role_peer_avg_salary" = "Lương trung bình của những người cùng vị trí", #"role_salary_gap_pct" = "Chênh lệch phần trăm so với người cùng vị trí", #"underpaid_10_flag" = "Dấu hiệu lương thấp hơn mức chung trên 10%", #"underpaid_25_flag" = "Dấu hiệu lương thấp hơn mức chung từ 25%", #"work_life_balance" = "Điểm cân bằng công việc và cuộc sống", #"churn" = "Tình trạng nhân viên đã nghỉ hay đang làm việc"],
					LocalizedTypes = Table.TransformColumns(Raw, {{"data_type", each Record.FieldOrDefault(DataTypes, _, _), type text}, {"display_order", each Text.PadStart(Text.From(_), 2, "0"), type text}}),
					RemovedTechnicalText = Table.RemoveColumns(LocalizedTypes, {"business_description", "source_or_logic", "analysis_role", "quality_note"}),
					AddedMeaning = Table.AddColumn(RemovedTechnicalText, "business_description", each Record.FieldOrDefault(DictionaryLabels, [field_name], "Thông tin dùng trong báo cáo"), type text),
					AddedSource = Table.AddColumn(AddedMeaning, "source_or_logic", each if [dictionary_scope] = "Input" then "Lấy trực tiếp từ hồ sơ nhân viên" else "Được sao chép, nhóm hoặc tính thêm cho báo cáo", type text),
					AddedRole = Table.AddColumn(AddedSource, "analysis_role", each if Text.EndsWith([field_name], "_order") then "Chỉ dùng để sắp xếp đúng thứ tự" else "Giúp phân nhóm, so sánh hoặc tính chỉ số", type text),
					AddedQuality = Table.AddColumn(AddedRole, "quality_note", each if [field_name] = "work_life_balance" then "Đang thiếu toàn bộ nên chưa dùng để phân tích" else if List.Contains({"salary", "peer_avg_salary", "peer_median_salary", "salary_gap_vs_peer_median_pct", "role_peer_avg_salary", "role_salary_gap_pct", "underpaid_10_flag", "underpaid_25_flag"}, [field_name]) then "Chỉ dùng để sàng lọc; cần nhân sự xem xét từng trường hợp" else if List.Contains({"gender", "marital_status"}, [field_name]) then "Thông tin nhạy cảm; chỉ nên xem ở mức tổng hợp" else if List.Contains({"analysis_year", "estimated_hire_year", "team_proxy"}, [field_name]) then "Là thông tin ước tính, không phải dữ liệu lịch sử thực tế" else "Đọc cùng bối cảnh và số lượng nhân viên", type text),
					InputRows = Table.SelectRows(AddedQuality, each [dictionary_scope] = "Input"),
					SourceFileRow = #table({"dictionary_scope", "display_order", "field_name", "data_type", "business_description", "source_or_logic", "analysis_role", "quality_note"}, {{"Input", "00", "employee_info.xlsx", "Excel workbook", "Tệp nguồn gồm 10.000 hồ sơ nhân viên và 22 trường dữ liệu", "Sheet employee_info; một dòng tương ứng một nhân viên", "Nguồn đầu vào của toàn bộ dự án", "Snapshot tại một thời điểm; chưa có lịch sử theo tháng"}}),
					DashboardRows = #table({"dictionary_scope", "display_order", "field_name", "data_type", "business_description", "source_or_logic", "analysis_role", "quality_note"}, {
						{"Output", "01", "Executive Overview | Tổng số nhân viên", "KPI", "Số nhân viên duy nhất trong phạm vi đang lọc", "DISTINCTCOUNT(employee_id)", "Executive Overview", "Đọc cùng bộ lọc và số lượng nhân viên"},
						{"Output", "02", "Executive Overview | Nhân viên đã nghỉ", "KPI", "Số nhân viên có trạng thái đã nghỉ", "Đếm employee_id với churn = TRUE", "Executive Overview", "Không thể hiện thời điểm nghỉ việc"},
						{"Output", "03", "Executive Overview | Tỷ lệ churn", "KPI", "Tỷ trọng nhân viên đã nghỉ trong tổng số nhân viên", "Nhân viên đã nghỉ / Tổng số nhân viên", "Executive Overview", "Chỉ mô tả snapshot hiện tại"},
						{"Output", "04", "Executive Overview | Churn theo phòng ban", "Bar chart", "So sánh tỷ lệ churn và quy mô theo phòng ban", "Tỷ lệ churn tính riêng trong từng phòng ban", "Executive Overview", "Chênh lệch nhỏ không chứng minh nguyên nhân"},
						{"Output", "05", "Executive Overview | Churn theo thâm niên", "Column chart", "So sánh churn giữa bốn nhóm thâm niên", "Tỷ lệ churn tính riêng trong từng tenure_band", "Executive Overview", "Các nhóm không chồng lấn"},
						{"Output", "06", "Executive Overview | Churn theo năm bắt đầu", "Column chart", "Góc nhìn cohort theo năm bắt đầu làm việc ước tính", "estimated_hire_year = 2026 - tenure", "Executive Overview", "Năm ước tính có thể lệch do tenure làm tròn"},
						{"Output", "07", "Churn Drivers | Churn theo giới tính", "Bar chart", "So sánh tỷ lệ churn giữa các nhóm giới tính", "Tỷ lệ churn tính riêng trong từng gender", "Churn Drivers", "Chỉ phân tích tổng hợp; không kết luận nguyên nhân"},
						{"Output", "08", "Churn Drivers | Churn theo giờ làm thêm", "Bar chart", "So sánh churn theo bốn nhóm giờ làm thêm", "Tỷ lệ churn theo overtime_band: 0; 1-10; 11-20; trên 20 giờ", "Churn Drivers", "Cần xác nhận kỳ đo giờ làm thêm"},
						{"Output", "09", "Churn Drivers | Giờ làm và mức hài lòng", "Matrix", "Đối chiếu churn và headcount theo workload và satisfaction", "Tỷ lệ churn theo monthly_hours_band x satisfaction_band", "Churn Drivers", "Dùng headcount để đánh giá độ ổn định"},
						{"Output", "10", "Churn Drivers | Đánh giá quản lý và thăng chức", "Combo chart", "Đặt churn cạnh tỷ lệ thăng chức theo nhóm feedback", "Churn rate và AVERAGE(promotions) theo feedback_band", "Churn Drivers", "Mối liên hệ không phải quan hệ nhân quả"},
						{"Output", "11", "Churn Drivers | Vắng mặt theo phòng ban", "Column chart", "So sánh mức vắng mặt trung bình giữa phòng ban", "AVERAGE(absenteeism) theo department", "Churn Drivers", "Cần xác nhận đơn vị của absenteeism"},
						{"Output", "12", "Compensation Fairness | Lương trung bình", "KPI", "Mức lương trung bình trong phạm vi đang lọc", "AVERAGE(salary)", "Compensation Fairness", "Đơn vị lương theo dữ liệu nguồn"},
						{"Output", "13", "Compensation Fairness | Mức lương giữa nhóm", "KPI", "Trung vị lương, ít bị ảnh hưởng bởi ngoại lệ", "MEDIAN(salary)", "Compensation Fairness", "Đọc cùng phân bố và quy mô mẫu"},
						{"Output", "14", "Compensation Fairness | Thấp hơn mức chung trên 10%", "KPI", "Số trường hợp cần sàng lọc về lương", "Đếm nhân viên có role_salary_gap_pct < -10%", "Compensation Fairness", "Không tự động kết luận trả lương thấp"},
						{"Output", "15", "Compensation Fairness | Thấp hơn mức chung từ 25%", "KPI", "Số trường hợp chênh lệch lớn cần ưu tiên xem xét", "Đếm nhân viên có role_salary_gap_pct <= -25%", "Compensation Fairness", "Cần nhân sự rà soát từng trường hợp"},
						{"Output", "16", "Compensation Fairness | Mức lương theo vị trí", "Bar chart", "So sánh lương trung bình và trung vị theo vị trí", "AVERAGE(salary) và MEDIAN(salary) theo job_role", "Compensation Fairness", "Chưa kiểm soát cấp bậc, kỹ năng và địa điểm"},
						{"Output", "17", "Compensation Fairness | Mức lương theo hiệu suất", "Column chart", "So sánh lương trung bình theo nhóm kết quả làm việc", "AVERAGE(salary) theo performance_group", "Compensation Fairness", "Không suy diễn hiệu suất gây ra chênh lệch lương"},
						{"Output", "18", "Compensation Fairness | Chênh lệch theo giới tính", "Combo chart", "Đối chiếu chênh lệch với nam và với người cùng vị trí", "(Lương nhóm - lương chuẩn) / lương chuẩn", "Compensation Fairness", "Không dùng để kết luận phân biệt đối xử"},
						{"Output", "19", "Key Talent Risk | Nhân viên hiệu suất cao", "KPI", "Quy mô nhóm có kết quả làm việc cao", "Đếm employee_id với performance_rating >= 4", "Key Talent Risk", "Định nghĩa hiệu suất cao là proxy tạm thời"},
						{"Output", "20", "Key Talent Risk | Nhân viên hiệu suất cao đã nghỉ", "KPI", "Số người hiệu suất cao có churn = TRUE", "Đếm employee_id với rating >= 4 và churn = TRUE", "Key Talent Risk", "Không có thời điểm nghỉ việc"},
						{"Output", "21", "Key Talent Risk | Tỷ lệ churn hiệu suất cao", "KPI", "Tỷ lệ nghỉ trong nhóm hiệu suất cao", "Nhân viên hiệu suất cao đã nghỉ / Nhân viên hiệu suất cao", "Key Talent Risk", "Đọc cùng headcount"},
						{"Output", "22", "Key Talent Risk | Phòng ban và vị trí", "Matrix", "Xác định nhóm có số người giỏi đã nghỉ đáng chú ý", "Headcount, churned và churn rate với rating >= 4", "Key Talent Risk", "Không thể hiện mức độ khó thay thế"},
						{"Output", "23", "Key Talent Risk | Thâm niên và nơi làm việc", "Bar charts", "So sánh churn của người hiệu suất cao theo hai chiều", "Tỷ lệ churn với rating >= 4 theo tenure_band hoặc work_location", "Key Talent Risk", "Không dùng để dự báo từng cá nhân"},
						{"Output", "24", "Recommendations | Bối cảnh", "Narrative", "Tóm tắt churn toàn công ty và giới hạn bằng chứng", "Đối chiếu KPI và tám kiểm định Chi-square", "Recommendations", "Không suy diễn quan hệ nhân quả"},
						{"Output", "25", "Recommendations | Retention Strategy", "Narrative card", "Hành động giữ chân dành cho quản lý và bộ phận Nhân sự", "Định hướng nghề nghiệp, check-in định kỳ, ghi nhận và khen thưởng", "Recommendations", "Theo dõi kết quả thực hiện ở cấp nhóm"},
						{"Output", "26", "Recommendations | Compensation Review", "Narrative card", "Hành động rà soát chênh lệch lương dành cho Nhân sự và Đãi ngộ", "Ưu tiên cờ từ 25% và xem xét đầy đủ bối cảnh công việc", "Recommendations", "Cờ sàng lọc không phải kết luận trả lương thiếu công bằng"},
						{"Output", "27", "Recommendations | Key Talent Retention", "Narrative card", "Hành động giữ chân và kế nhiệm tại hai vai trò IT nổi bật", "Định hướng nghề nghiệp, điều chuyển phù hợp và kế hoạch kế nhiệm", "Recommendations", "Không gắn nhãn rủi ro cho từng cá nhân"}
					}),
					FinalDictionary = Table.Combine({SourceFileRow, InputRows, DashboardRows})
				in
					FinalDictionary

