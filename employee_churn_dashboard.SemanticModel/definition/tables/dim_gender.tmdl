					Raw = Source{[Schema="employees_churn", Item="dim_gender"]}[Data],
					Localized1 = Table.ReplaceValue(Raw, "Female", "Nữ", Replacer.ReplaceValue, {"gender"}),
					Localized2 = Table.ReplaceValue(Localized1, "Male", "Nam", Replacer.ReplaceValue, {"gender"}),
