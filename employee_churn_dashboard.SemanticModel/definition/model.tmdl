model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["mart_employee_analytics","dim_department","dim_job_role","dim_gender","dim_work_location","mart_data_dictionary"]

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

ref table mart_employee_analytics
ref table dim_department
ref table dim_job_role
ref table dim_gender
ref table dim_work_location
ref table mart_data_dictionary
ref table 'All Measures'

ref cultureInfo en-US

